# Godot editor cache / import data (regenerated on open)
.godot/
*.translation

# Exports
/build/

# Steam: never commit the App ID file or SDK / GodotSteam redistributables.
steam_appid.txt
addons/godotsteam/**/*.dll
addons/godotsteam/**/*.so
addons/godotsteam/**/*.dylib
*.dll

# .NET build output
bin/
obj/

# Local scratch scripts (a leading underscore + dbg / probe = never committed)
_dbg*.gd*
_st_one.gd*

# Local Claude Code settings
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
